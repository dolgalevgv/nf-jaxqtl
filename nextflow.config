manifest {
    name = 'nf-jaxqtl'
    description = 'Nextflow pipeline for running JaxQTL with single cell data'
    nextflowVersion = '>=25.10.0'
}

params {
    adata = null
    group_col = null
    covar = null
    gene_gtf = null
    cis_window = 1000000
    vcf = null
    donors = null
    source_fasta = null
    target_fasta = null
    chain_file = null
    min_mac = 10
    max_missing = 0.02
    ld_exclude_bed = null
    min_gene_expr_pct = 0.3
    n_genotype_pcs = 3
    n_expr_pcs = 2
    outdir = 'results'
    help = false
}

process {
    errorStrategy = 'terminate'
    maxForks = 4
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${projectDir}/work/singularity"
        process.module = 'Singularity/1.2.5'
    }
    slurm {
        process {
            executor = 'slurm'
            queue = 'normal'

            // Initial resource requests; tune using the execution reports.
            cpus = 1
            memory = 8.GB
            time = 24.h

            withName: PREPARE_DONORS {
                memory = 1.GB
                time = 1.h
            }
            withName: 'PLINK_.*' {
                cpus = 4
            }
            withName: PREPARE_QTL_PHENOTYPES {
                cpus = 1
                memory = 16.GB
                time = 4.h
            }
            withName: 'JAXQTL_.*' {
                cpus = 16
                memory = 64.GB
                time = 6.h
            }
        }
        executor {
            queueSize = 6
            jobName = { fixed_name = "${task.name}" -> fixed_name.replaceAll( '[():\\s]', '_' ) }
        }
    }
}
trace {
    enabled = !params.help
    file = "${params.outdir}/execution/trace.tsv"
    overwrite = true
}
report {
    enabled = !params.help
    file = "${params.outdir}/execution/report.html"
    overwrite = true
}
timeline {
    enabled = !params.help
    file = "${params.outdir}/execution/timeline.html"
    overwrite = true
}